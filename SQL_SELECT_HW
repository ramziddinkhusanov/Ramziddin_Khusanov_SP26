-- ============================================
-- TRANSACTION 1: INSERT FILMS
-- ============================================
BEGIN;

-- We use INSERT ... SELECT to avoid hardcoding IDs
-- and allow reusability of script.

INSERT INTO public.film (title, description, release_year, rental_duration, rental_rate, length, replacement_cost, rating, last_update)
SELECT *
FROM (
    SELECT 'Inception', 'Sci-fi thriller', 2010, 7, 4.99, 148, 19.99, 'PG-13', CURRENT_DATE
    UNION ALL
    SELECT 'The Godfather', 'Crime drama', 1972, 14, 9.99, 175, 24.99, 'R', CURRENT_DATE
    UNION ALL
    SELECT 'Interstellar', 'Space exploration', 2014, 21, 19.99, 169, 29.99, 'PG-13', CURRENT_DATE
) new_films
WHERE NOT EXISTS (
    SELECT 1 FROM public.film f WHERE f.title = new_films.column1
)
RETURNING film_id;

-- Justification:
-- - WHERE NOT EXISTS prevents duplicates
-- - INSERT ... SELECT avoids hardcoded values
-- - Script is rerunnable

COMMIT;

-- ============================================
-- TRANSACTION 2: INSERT ACTORS
-- ============================================
BEGIN;

INSERT INTO public.actor (first_name, last_name, last_update)
SELECT *
FROM (
    SELECT 'Leonardo', 'DiCaprio', CURRENT_DATE
    UNION ALL
    SELECT 'Matthew', 'McConaughey', CURRENT_DATE
    UNION ALL
    SELECT 'Anne', 'Hathaway', CURRENT_DATE
    UNION ALL
    SELECT 'Al', 'Pacino', CURRENT_DATE
    UNION ALL
    SELECT 'Marlon', 'Brando', CURRENT_DATE
    UNION ALL
    SELECT 'Joseph', 'Gordon-Levitt', CURRENT_DATE
) new_actors
WHERE NOT EXISTS (
    SELECT 1 FROM public.actor a
    WHERE a.first_name = new_actors.column1
      AND a.last_name = new_actors.column2
)
RETURNING actor_id;

-- Justification:
-- - Actor uniqueness ensured via name matching
-- - Avoid duplicates using WHERE NOT EXISTS

COMMIT;

-- ============================================
-- TRANSACTION 3: LINK FILMS & ACTORS
-- ============================================
BEGIN;

INSERT INTO public.film_actor (actor_id, film_id, last_update)
SELECT a.actor_id, f.film_id, CURRENT_DATE
FROM public.actor a
JOIN public.film f ON (
    (f.title = 'Inception' AND a.last_name IN ('DiCaprio','Gordon-Levitt')) OR
    (f.title = 'Interstellar' AND a.last_name IN ('McConaughey','Hathaway')) OR
    (f.title = 'The Godfather' AND a.last_name IN ('Pacino','Brando'))
)
WHERE NOT EXISTS (
    SELECT 1 FROM public.film_actor fa
    WHERE fa.actor_id = a.actor_id AND fa.film_id = f.film_id
)
RETURNING *;

-- Justification:
-- - Relationship established via JOIN
-- - Referential integrity preserved

COMMIT;

-- ============================================
-- TRANSACTION 4: ADD TO INVENTORY
-- ============================================
BEGIN;

INSERT INTO public.inventory (film_id, store_id, last_update)
SELECT f.film_id, s.store_id, CURRENT_DATE
FROM public.film f
CROSS JOIN public.store s
WHERE f.title IN ('Inception','Interstellar','The Godfather')
AND NOT EXISTS (
    SELECT 1 FROM public.inventory i
    WHERE i.film_id = f.film_id
)
LIMIT 3
RETURNING inventory_id;

-- Justification:
-- - No hardcoded IDs
-- - Avoid duplicates

COMMIT;

-- ============================================
-- TRANSACTION 5: UPDATE CUSTOMER
-- ============================================
BEGIN;

UPDATE public.customer
SET first_name = 'Iroda',
    last_name = 'Khusanova',
    last_update = CURRENT_DATE
WHERE customer_id = (
    SELECT customer_id
    FROM public.customer
    WHERE customer_id IN (
        SELECT customer_id
        FROM public.rental
        GROUP BY customer_id
        HAVING COUNT(*) >= 43
    )
    LIMIT 1
)
RETURNING *;

-- Justification:
-- - No hardcoded ID
-- - Ensures customer has required history

COMMIT;

-- ============================================
-- TRANSACTION 6: CLEAN PREVIOUS RECORDS
-- ============================================
BEGIN;

-- DELETE safely using SELECT preview (recommended before running)

DELETE FROM public.payment
WHERE customer_id IN (
    SELECT customer_id FROM public.customer WHERE first_name = 'Iroda'
);

DELETE FROM public.rental
WHERE customer_id IN (
    SELECT customer_id FROM public.customer WHERE first_name = 'Iroda'
);

-- Justification:
-- - Safe deletion only for target customer
-- - Referential integrity preserved

COMMIT;

-- ============================================
-- TRANSACTION 7: RENT & PAY
-- ============================================
BEGIN;

INSERT INTO public.rental (rental_date, inventory_id, customer_id, return_date, staff_id, last_update)
SELECT CURRENT_DATE, i.inventory_id, c.customer_id, CURRENT_DATE + INTERVAL '3 days', 1, CURRENT_DATE
FROM public.inventory i
JOIN public.film f ON f.film_id = i.film_id
JOIN public.customer c ON c.first_name = 'Iroda'
WHERE f.title IN ('Inception','Interstellar','The Godfather')
RETURNING rental_id;

INSERT INTO public.payment (customer_id, staff_id, rental_id, amount, payment_date)
SELECT c.customer_id, 1, r.rental_id, 9.99, CURRENT_DATE
FROM public.rental r
JOIN public.customer c ON c.customer_id = r.customer_id
WHERE c.first_name = 'Iroda'
RETURNING payment_id;

-- Justification:
-- - Relationships maintained
-- - No hardcoded IDs

COMMIT;

-- ============================================
-- TRANSACTION NOTES
-- ============================================

-- Why transactions?
-- - Ensure atomic operations
-- - If failure → rollback possible

-- If transaction fails:
-- - No partial data inserted

-- Referential integrity:
-- - Maintained via FK relations

