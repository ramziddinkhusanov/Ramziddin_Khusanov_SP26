
-- ============================================================
-- PART 1 / TASK 1
-- The marketing team needs a list of animation movies between 2017 and 2019
-- to promote family-friendly content in an upcoming season in stores.
-- Show all animation movies released during this period with rate more than 1,
-- sorted alphabetically.
--
-- Assumptions:
--   - release_year is stored correctly in public.film.
--   - category names may require case-insensitive comparison.
-- Tradeoff:
--   - JOIN version is direct and usually easiest to read for normalized schemas.
-- ============================================================

-- P1.T1.V1 - JOIN
SELECT
    f.title
FROM public.film AS f
INNER JOIN public.film_category AS fc
    ON fc.film_id = f.film_id
INNER JOIN public.category AS c
    ON c.category_id = fc.category_id
WHERE LOWER(c.name) = 'animation'
  AND f.release_year BETWEEN 2017 AND 2019
  AND f.rental_rate > 1
ORDER BY f.title ASC;


-- P1.T1.V2 - SUBQUERY
SELECT
    film_list.title
FROM (
    SELECT
        f.film_id,
        f.title
    FROM public.film AS f
    WHERE f.release_year BETWEEN 2017 AND 2019
      AND f.rental_rate > 1
      AND f.film_id IN (
          SELECT fc.film_id
          FROM public.film_category AS fc
          INNER JOIN public.category AS c
              ON c.category_id = fc.category_id
          WHERE LOWER(c.name) = 'animation'
      )
) AS film_list
ORDER BY film_list.title ASC;


-- P1.T1.V3 - CTE
WITH animation_films AS (
    SELECT
        f.film_id,
        f.title
    FROM public.film AS f
    INNER JOIN public.film_category AS fc
        ON fc.film_id = f.film_id
    INNER JOIN public.category AS c
        ON c.category_id = fc.category_id
    WHERE LOWER(c.name) = 'animation'
      AND f.release_year BETWEEN 2017 AND 2019
      AND f.rental_rate > 1
)
SELECT
    af.title
FROM animation_films AS af
ORDER BY af.title ASC;



-- ============================================================
-- PART 1 / TASK 2
-- The finance department requires a report on store performance to assess
-- profitability and plan resource allocation for stores after March 2017.
-- Calculate the revenue earned by each rental store after March 2017 (since April)
-- include columns: address and address2 as one column, revenue.
--
-- Assumptions:
--   - revenue is derived from public.payment.amount.
--   - store revenue should be attributed through inventory -> rental -> payment.
--   - after March 2017 means from 2017-04-01 onward.
-- Tradeoff:
--   - grouped aggregation on joined transactional tables is transparent and auditable.
-- ============================================================

-- P1.T2.V1 - JOIN
SELECT
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2) AS store_address,
    ROUND(SUM(p.amount), 2) AS revenue
FROM public.store AS s
INNER JOIN public.address AS a
    ON a.address_id = s.address_id
INNER JOIN public.inventory AS i
    ON i.store_id = s.store_id
INNER JOIN public.rental AS r
    ON r.inventory_id = i.inventory_id
INNER JOIN public.payment AS p
    ON p.rental_id = r.rental_id
WHERE p.payment_date >= DATE '2017-04-01'
GROUP BY
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2)
ORDER BY revenue DESC, s.store_id ASC;


-- P1.T2.V2 - SUBQUERY
SELECT
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2) AS store_address,
    ROUND((
        SELECT SUM(p.amount)
        FROM public.inventory AS i
        INNER JOIN public.rental AS r
            ON r.inventory_id = i.inventory_id
        INNER JOIN public.payment AS p
            ON p.rental_id = r.rental_id
        WHERE i.store_id = s.store_id
          AND p.payment_date >= DATE '2017-04-01'
    ), 2) AS revenue
FROM public.store AS s
INNER JOIN public.address AS a
    ON a.address_id = s.address_id
ORDER BY revenue DESC, s.store_id ASC;


-- P1.T2.V3 - CTE
WITH store_revenue AS (
    SELECT
        i.store_id,
        SUM(p.amount) AS revenue
    FROM public.inventory AS i
    INNER JOIN public.rental AS r
        ON r.inventory_id = i.inventory_id
    INNER JOIN public.payment AS p
        ON p.rental_id = r.rental_id
    WHERE p.payment_date >= DATE '2017-04-01'
    GROUP BY i.store_id
)
SELECT
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2) AS store_address,
    ROUND(sr.revenue, 2) AS revenue
FROM public.store AS s
INNER JOIN public.address AS a
    ON a.address_id = s.address_id
INNER JOIN store_revenue AS sr
    ON sr.store_id = s.store_id
ORDER BY revenue DESC, s.store_id ASC;



-- ============================================================
-- PART 1 / TASK 3
-- The marketing department aims to identify the most successful actors since 2015
-- to boost customer interest in their films.
-- Show top-5 actors by number of movies released from 2015 onward.
--
-- Assumptions:
--   - "since 2015" means release_year >= 2015.
--   - COUNT(DISTINCT fa.film_id) is unnecessary because (actor_id, film_id)
--     is the composite primary key in public.film_actor.
-- Tradeoff:
--   - removing DISTINCT avoids unnecessary work by the database engine.
-- ============================================================

-- P1.T3.V1 - JOIN
SELECT
    a.first_name,
    a.last_name,
    COUNT(fa.film_id) AS number_of_movies
FROM public.actor AS a
INNER JOIN public.film_actor AS fa
    ON fa.actor_id = a.actor_id
INNER JOIN public.film AS f
    ON f.film_id = fa.film_id
WHERE f.release_year >= 2015
GROUP BY
    a.actor_id,
    a.first_name,
    a.last_name
ORDER BY number_of_movies DESC, a.last_name ASC, a.first_name ASC
LIMIT 5;


-- P1.T3.V2 - SUBQUERY
SELECT
    ranked_actors.first_name,
    ranked_actors.last_name,
    ranked_actors.number_of_movies
FROM (
    SELECT
        a.actor_id,
        a.first_name,
        a.last_name,
        COUNT(fa.film_id) AS number_of_movies
    FROM public.actor AS a
    INNER JOIN public.film_actor AS fa
        ON fa.actor_id = a.actor_id
    WHERE fa.film_id IN (
        SELECT f.film_id
        FROM public.film AS f
        WHERE f.release_year >= 2015
    )
    GROUP BY
        a.actor_id,
        a.first_name,
        a.last_name
) AS ranked_actors
ORDER BY ranked_actors.number_of_movies DESC,
         ranked_actors.last_name ASC,
         ranked_actors.first_name ASC
LIMIT 5;


-- P1.T3.V3 - CTE
WITH actor_movie_counts AS (
    SELECT
        a.actor_id,
        a.first_name,
        a.last_name,
        COUNT(fa.film_id) AS number_of_movies
    FROM public.actor AS a
    INNER JOIN public.film_actor AS fa
        ON fa.actor_id = a.actor_id
    INNER JOIN public.film AS f
        ON f.film_id = fa.film_id
    WHERE f.release_year >= 2015
    GROUP BY
        a.actor_id,
        a.first_name,
        a.last_name
)
SELECT
    amc.first_name,
    amc.last_name,
    amc.number_of_movies
FROM actor_movie_counts AS amc
ORDER BY amc.number_of_movies DESC, amc.last_name ASC, amc.first_name ASC
LIMIT 5;



-- ============================================================
-- PART 1 / TASK 4
-- The marketing team needs to track the production trends of Drama, Travel,
-- and Documentary films to inform genre-specific marketing strategies.
-- Show number of Drama, Travel, Documentary per year
-- (release_year, number_of_drama_movies, number_of_travel_movies,
--  number_of_documentary_movies), sorted by release year descending.
--
-- Assumptions:
--   - a film belongs to one row in public.film_category in dvdrental.
--   - NULL-handling should produce zero counts when a category is absent for a year.
--   - case-insensitive category comparison is safer.
-- Tradeoff:
--   - conditional aggregation is efficient and produces a compact report.
-- ============================================================

-- P1.T4.V1 - JOIN
SELECT
    f.release_year,
    COALESCE(SUM(CASE WHEN LOWER(c.name) = 'drama' THEN 1 ELSE 0 END), 0) AS number_of_drama_movies,
    COALESCE(SUM(CASE WHEN LOWER(c.name) = 'travel' THEN 1 ELSE 0 END), 0) AS number_of_travel_movies,
    COALESCE(SUM(CASE WHEN LOWER(c.name) = 'documentary' THEN 1 ELSE 0 END), 0) AS number_of_documentary_movies
FROM public.film AS f
INNER JOIN public.film_category AS fc
    ON fc.film_id = f.film_id
INNER JOIN public.category AS c
    ON c.category_id = fc.category_id
WHERE LOWER(c.name) IN ('drama', 'travel', 'documentary')
GROUP BY f.release_year
ORDER BY f.release_year DESC;


-- P1.T4.V2 - SUBQUERY
SELECT
    y.release_year,
    COALESCE((
        SELECT COUNT(*)
        FROM public.film AS f1
        INNER JOIN public.film_category AS fc1
            ON fc1.film_id = f1.film_id
        INNER JOIN public.category AS c1
            ON c1.category_id = fc1.category_id
        WHERE f1.release_year = y.release_year
          AND LOWER(c1.name) = 'drama'
    ), 0) AS number_of_drama_movies,
    COALESCE((
        SELECT COUNT(*)
        FROM public.film AS f2
        INNER JOIN public.film_category AS fc2
            ON fc2.film_id = f2.film_id
        INNER JOIN public.category AS c2
            ON c2.category_id = fc2.category_id
        WHERE f2.release_year = y.release_year
          AND LOWER(c2.name) = 'travel'
    ), 0) AS number_of_travel_movies,
    COALESCE((
        SELECT COUNT(*)
        FROM public.film AS f3
        INNER JOIN public.film_category AS fc3
            ON fc3.film_id = f3.film_id
        INNER JOIN public.category AS c3
            ON c3.category_id = fc3.category_id
        WHERE f3.release_year = y.release_year
          AND LOWER(c3.name) = 'documentary'
    ), 0) AS number_of_documentary_movies
FROM (
    SELECT DISTINCT f.release_year
    FROM public.film AS f
) AS y
ORDER BY y.release_year DESC;


-- P1.T4.V3 - CTE
WITH category_counts AS (
    SELECT
        f.release_year,
        LOWER(c.name) AS category_name,
        COUNT(*) AS movie_count
    FROM public.film AS f
    INNER JOIN public.film_category AS fc
        ON fc.film_id = f.film_id
    INNER JOIN public.category AS c
        ON c.category_id = fc.category_id
    WHERE LOWER(c.name) IN ('drama', 'travel', 'documentary')
    GROUP BY
        f.release_year,
        LOWER(c.name)
)
SELECT
    cc.release_year,
    COALESCE(SUM(CASE WHEN cc.category_name = 'drama' THEN cc.movie_count ELSE 0 END), 0) AS number_of_drama_movies,
    COALESCE(SUM(CASE WHEN cc.category_name = 'travel' THEN cc.movie_count ELSE 0 END), 0) AS number_of_travel_movies,
    COALESCE(SUM(CASE WHEN cc.category_name = 'documentary' THEN cc.movie_count ELSE 0 END), 0) AS number_of_documentary_movies
FROM category_counts AS cc
GROUP BY cc.release_year
ORDER BY cc.release_year DESC;



-- ============================================================
-- PART 2 / TASK 1
-- The HR department aims to reward top-performing employees in 2017
-- with bonuses to recognize their contribution to stores revenue.
-- Show which three employees generated the most revenue in 2017.
--
-- Required review fix:
--   - use EXTRACT() for year filtering.
-- Assumptions:
--   - revenue is summed from payment.amount handled by a staff member.
--   - staff store is shown from public.staff.store_id.
-- Tradeoff:
--   - using EXTRACT(YEAR ...) is explicit for year-based reporting.
-- ============================================================

-- P2.T1.V1 - JOIN
SELECT
    s.staff_id,
    s.first_name,
    s.last_name,
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2) AS store_address,
    ROUND(SUM(p.amount), 2) AS revenue_2017
FROM public.staff AS s
INNER JOIN public.store AS st
    ON st.store_id = s.store_id
INNER JOIN public.address AS a
    ON a.address_id = st.address_id
INNER JOIN public.payment AS p
    ON p.staff_id = s.staff_id
WHERE EXTRACT(YEAR FROM p.payment_date) = 2017
GROUP BY
    s.staff_id,
    s.first_name,
    s.last_name,
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2)
ORDER BY revenue_2017 DESC, s.last_name ASC, s.first_name ASC
LIMIT 3;


-- P2.T1.V2 - SUBQUERY
SELECT
    s.staff_id,
    s.first_name,
    s.last_name,
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2) AS store_address,
    ROUND((
        SELECT SUM(p.amount)
        FROM public.payment AS p
        WHERE p.staff_id = s.staff_id
          AND EXTRACT(YEAR FROM p.payment_date) = 2017
    ), 2) AS revenue_2017
FROM public.staff AS s
INNER JOIN public.store AS st
    ON st.store_id = s.store_id
INNER JOIN public.address AS a
    ON a.address_id = st.address_id
ORDER BY revenue_2017 DESC, s.last_name ASC, s.first_name ASC
LIMIT 3;


-- P2.T1.V3 - CTE
WITH staff_revenue_2017 AS (
    SELECT
        p.staff_id,
        SUM(p.amount) AS revenue_2017
    FROM public.payment AS p
    WHERE EXTRACT(YEAR FROM p.payment_date) = 2017
    GROUP BY p.staff_id
)
SELECT
    s.staff_id,
    s.first_name,
    s.last_name,
    s.store_id,
    CONCAT_WS(' ', a.address, a.address2) AS store_address,
    ROUND(sr.revenue_2017, 2) AS revenue_2017
FROM public.staff AS s
INNER JOIN staff_revenue_2017 AS sr
    ON sr.staff_id = s.staff_id
INNER JOIN public.store AS st
    ON st.store_id = s.store_id
INNER JOIN public.address AS a
    ON a.address_id = st.address_id
ORDER BY revenue_2017 DESC, s.last_name ASC, s.first_name ASC
LIMIT 3;



-- ============================================================
-- PART 2 / TASK 2
-- The management team wants to identify the most popular movies and their
-- target audience age groups to optimize marketing efforts.
-- Show which 5 movies were rented more than others (number of rentals),
-- and what's the expected audience according to the Motion Picture Association
-- film rating system.
--
-- Required review fix:
--   - use textual audience descriptions, not numeric ages.
--   - handle rating comparison safely.
-- Tradeoff:
--   - CASE expression is best here because rating codes map to a fixed vocabulary.
-- ============================================================

-- P2.T2.V1 - JOIN
SELECT
    f.title,
    COUNT(r.rental_id) AS rentals,
    CASE
        WHEN UPPER(f.rating::text) = 'G' THEN 'All Ages'
        WHEN UPPER(f.rating::text) = 'PG' THEN 'Parental Guidance Suggested'
        WHEN UPPER(f.rating::text) = 'PG-13' THEN 'Inappropriate for Children Under 13'
        WHEN UPPER(f.rating::text) = 'R' THEN 'Children Under 17 Require Accompanying Adult'
        WHEN UPPER(f.rating::text) = 'NC-17' THEN 'Inappropriate for Children Under 17'
        ELSE 'Unknown Rating'
    END AS expected_audience
FROM public.film AS f
INNER JOIN public.inventory AS i
    ON i.film_id = f.film_id
INNER JOIN public.rental AS r
    ON r.inventory_id = i.inventory_id
GROUP BY
    f.film_id,
    f.title,
    f.rating
ORDER BY rentals DESC, f.title ASC
LIMIT 5;


-- P2.T2.V2 - SUBQUERY
SELECT
    ranked_films.title,
    ranked_films.rentals,
    CASE
        WHEN UPPER(ranked_films.rating::text) = 'G' THEN 'All Ages'
        WHEN UPPER(ranked_films.rating::text) = 'PG' THEN 'Parental Guidance Suggested'
        WHEN UPPER(ranked_films.rating::text) = 'PG-13' THEN 'Inappropriate for Children Under 13'
        WHEN UPPER(ranked_films.rating::text) = 'R' THEN 'Children Under 17 Require Accompanying Adult'
        WHEN UPPER(ranked_films.rating::text) = 'NC-17' THEN 'Inappropriate for Children Under 17'
        ELSE 'Unknown Rating'
    END AS expected_audience
FROM (
    SELECT
        f.film_id,
        f.title,
        f.rating,
        (
            SELECT COUNT(*)
            FROM public.inventory AS i
            INNER JOIN public.rental AS r
                ON r.inventory_id = i.inventory_id
            WHERE i.film_id = f.film_id
        ) AS rentals
    FROM public.film AS f
) AS ranked_films
ORDER BY ranked_films.rentals DESC, ranked_films.title ASC
LIMIT 5;


-- P2.T2.V3 - CTE
WITH film_rentals AS (
    SELECT
        f.film_id,
        f.title,
        f.rating,
        COUNT(r.rental_id) AS rentals
    FROM public.film AS f
    INNER JOIN public.inventory AS i
        ON i.film_id = f.film_id
    INNER JOIN public.rental AS r
        ON r.inventory_id = i.inventory_id
    GROUP BY
        f.film_id,
        f.title,
        f.rating
)
SELECT
    fr.title,
    fr.rentals,
    CASE
        WHEN UPPER(fr.rating::text) = 'G' THEN 'All Ages'
        WHEN UPPER(fr.rating::text) = 'PG' THEN 'Parental Guidance Suggested'
        WHEN UPPER(fr.rating::text) = 'PG-13' THEN 'Inappropriate for Children Under 13'
        WHEN UPPER(fr.rating::text) = 'R' THEN 'Children Under 17 Require Accompanying Adult'
        WHEN UPPER(fr.rating::text) = 'NC-17' THEN 'Inappropriate for Children Under 17'
        ELSE 'Unknown Rating'
    END AS expected_audience
FROM film_rentals AS fr
ORDER BY fr.rentals DESC, fr.title ASC
LIMIT 5;



-- ============================================================
-- PART 3 / TASK 1
-- The stores' marketing team wants to analyze actors' inactivity periods
-- to select those with notable career breaks for targeted promotional campaigns.
-- Version of the task:
--   show actors with the longest inactivity measured as
--   current year - latest release year.
--
-- Assumptions:
--   - CURRENT_DATE is acceptable for "current year".
--   - actors without films are absent from film_actor and therefore excluded.
-- Tradeoff:
--   - this method is simple but only measures inactivity since the latest film,
--     not the maximum gap between films.
-- ============================================================

-- P3.T1.V1 - JOIN
SELECT
    a.first_name,
    a.last_name,
    MAX(f.release_year) AS last_release_year,
    EXTRACT(YEAR FROM CURRENT_DATE) - MAX(f.release_year) AS inactivity_years
FROM public.actor AS a
INNER JOIN public.film_actor AS fa
    ON fa.actor_id = a.actor_id
INNER JOIN public.film AS f
    ON f.film_id = fa.film_id
GROUP BY
    a.actor_id,
    a.first_name,
    a.last_name
ORDER BY inactivity_years DESC, a.last_name ASC, a.first_name ASC
LIMIT 10;


-- P3.T1.V2 - SUBQUERY
SELECT
    actor_summary.first_name,
    actor_summary.last_name,
    actor_summary.last_release_year,
    EXTRACT(YEAR FROM CURRENT_DATE) - actor_summary.last_release_year AS inactivity_years
FROM (
    SELECT
        a.actor_id,
        a.first_name,
        a.last_name,
        (
            SELECT MAX(f.release_year)
            FROM public.film_actor AS fa
            INNER JOIN public.film AS f
                ON f.film_id = fa.film_id
            WHERE fa.actor_id = a.actor_id
        ) AS last_release_year
    FROM public.actor AS a
) AS actor_summary
WHERE actor_summary.last_release_year IS NOT NULL
ORDER BY inactivity_years DESC, actor_summary.last_name ASC, actor_summary.first_name ASC
LIMIT 10;


-- P3.T1.V3 - CTE
WITH actor_last_film AS (
    SELECT
        a.actor_id,
        a.first_name,
        a.last_name,
        MAX(f.release_year) AS last_release_year
    FROM public.actor AS a
    INNER JOIN public.film_actor AS fa
        ON fa.actor_id = a.actor_id
    INNER JOIN public.film AS f
        ON f.film_id = fa.film_id
    GROUP BY
        a.actor_id,
        a.first_name,
        a.last_name
)
SELECT
    alf.first_name,
    alf.last_name,
    alf.last_release_year,
    EXTRACT(YEAR FROM CURRENT_DATE) - alf.last_release_year AS inactivity_years
FROM actor_last_film AS alf
ORDER BY inactivity_years DESC, alf.last_name ASC, alf.first_name ASC
LIMIT 10;



-- ============================================================
-- PART 3 / TASK 2
-- The stores' marketing team also wants to analyze maximum inactivity gaps
-- between sequential films for each actor, WITHOUT using window functions.
--
-- Required review fix:
--   - window functions are forbidden.
-- Approach:
--   - emulate previous film year using self-join and MAX(previous.release_year).
-- Tradeoff:
--   - this is more verbose than LAG(), but fully respects the assignment rules.
-- ============================================================

-- P3.T2.V1 - JOIN
SELECT
    g.first_name,
    g.last_name,
    MAX(g.release_year - g.prev_year) AS max_inactivity_gap
FROM (
    SELECT
        af.actor_id,
        af.first_name,
        af.last_name,
        af.release_year,
        MAX(prev.release_year) AS prev_year
    FROM (
        SELECT
            a.actor_id,
            a.first_name,
            a.last_name,
            f.release_year
        FROM public.actor AS a
        INNER JOIN public.film_actor AS fa
            ON fa.actor_id = a.actor_id
        INNER JOIN public.film AS f
            ON f.film_id = fa.film_id
    ) AS af
    LEFT JOIN (
        SELECT
            a.actor_id,
            f.release_year
        FROM public.actor AS a
        INNER JOIN public.film_actor AS fa
            ON fa.actor_id = a.actor_id
        INNER JOIN public.film AS f
            ON f.film_id = fa.film_id
    ) AS prev
        ON prev.actor_id = af.actor_id
       AND prev.release_year < af.release_year
    GROUP BY
        af.actor_id,
        af.first_name,
        af.last_name,
        af.release_year
) AS g
WHERE g.prev_year IS NOT NULL
GROUP BY
    g.actor_id,
    g.first_name,
    g.last_name
ORDER BY max_inactivity_gap DESC, g.last_name ASC, g.first_name ASC
LIMIT 10;


-- P3.T2.V2 - SUBQUERY
SELECT
    result_set.first_name,
    result_set.last_name,
    MAX(result_set.year_gap) AS max_inactivity_gap
FROM (
    SELECT
        af.actor_id,
        af.first_name,
        af.last_name,
        af.release_year,
        af.release_year - (
            SELECT MAX(prev_f.release_year)
            FROM public.film_actor AS prev_fa
            INNER JOIN public.film AS prev_f
                ON prev_f.film_id = prev_fa.film_id
            WHERE prev_fa.actor_id = af.actor_id
              AND prev_f.release_year < af.release_year
        ) AS year_gap
    FROM (
        SELECT
            a.actor_id,
            a.first_name,
            a.last_name,
            f.release_year
        FROM public.actor AS a
        INNER JOIN public.film_actor AS fa
            ON fa.actor_id = a.actor_id
        INNER JOIN public.film AS f
            ON f.film_id = fa.film_id
    ) AS af
) AS result_set
WHERE result_set.year_gap IS NOT NULL
GROUP BY
    result_set.actor_id,
    result_set.first_name,
    result_set.last_name
ORDER BY max_inactivity_gap DESC, result_set.last_name ASC, result_set.first_name ASC
LIMIT 10;


-- P3.T2.V3 - CTE
WITH actor_films AS (
    SELECT
        a.actor_id,
        a.first_name,
        a.last_name,
        f.release_year
    FROM public.actor AS a
    INNER JOIN public.film_actor AS fa
        ON fa.actor_id = a.actor_id
    INNER JOIN public.film AS f
        ON f.film_id = fa.film_id
),
ordered_films AS (
    SELECT
        af.actor_id,
        af.first_name,
        af.last_name,
        af.release_year,
        MAX(prev.release_year) AS prev_year
    FROM actor_films AS af
    LEFT JOIN actor_films AS prev
        ON prev.actor_id = af.actor_id
       AND prev.release_year < af.release_year
    GROUP BY
        af.actor_id,
        af.first_name,
        af.last_name,
        af.release_year
),
gaps AS (
    SELECT
        ofi.actor_id,
        ofi.first_name,
        ofi.last_name,
        ofi.release_year,
        ofi.prev_year,
        ofi.release_year - ofi.prev_year AS year_gap
    FROM ordered_films AS ofi
    WHERE ofi.prev_year IS NOT NULL
)
SELECT
    g.first_name,
    g.last_name,
    MAX(g.year_gap) AS max_inactivity_gap
FROM gaps AS g
GROUP BY
    g.actor_id,
    g.first_name,
    g.last_name
ORDER BY max_inactivity_gap DESC, g.last_name ASC, g.first_name ASC
LIMIT 10;

