-- IMPORTANT: AUTOCOMMIT ON

-- 1. CREATE TABLE
CREATE TABLE table_to_delete AS
SELECT 'veeeeeeery_long_string' || x AS col
FROM generate_series(1,(10^7)::int) x;

-- 2. CHECK SIZE
SELECT pg_size_pretty(pg_total_relation_size('table_to_delete'));

-- 3. DELETE TEST
DELETE FROM table_to_delete
WHERE REPLACE(col,'veeeeeeery_long_string','')::int % 3 = 0;

-- Observation:
-- - DELETE is slow
-- - Space NOT freed immediately

-- CHECK SIZE AGAIN
SELECT pg_size_pretty(pg_total_relation_size('table_to_delete'));

-- VACUUM
VACUUM FULL VERBOSE table_to_delete;

-- CHECK SIZE AGAIN
SELECT pg_size_pretty(pg_total_relation_size('table_to_delete'));

-- RECREATE TABLE
DROP TABLE table_to_delete;

-- 4. TRUNCATE TEST
CREATE TABLE table_to_delete AS
SELECT 'veeeeeeery_long_string' || x AS col
FROM generate_series(1,(10^7)::int) x;

TRUNCATE table_to_delete;

-- ============================================
-- ANALYSIS
-- ============================================

-- DELETE:
-- - Slow (row-by-row)
-- - Keeps disk space
-- - Can ROLLBACK

-- TRUNCATE:
-- - Very fast
-- - Frees space immediately
-- - Cannot rollback (in some configs)

-- VACUUM FULL:
-- - Rewrites table
-- - Releases unused space

-- WHY DELETE DOESN'T FREE SPACE:
-- - Marks rows as dead, not removed physically

-- WHY TRUNCATE IS FAST:
-- - Removes whole table data at once
